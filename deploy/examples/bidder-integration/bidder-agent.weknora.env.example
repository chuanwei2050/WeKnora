# bidder-agent 后端环境变量示例（外挂独立 WeKnora，同域反代模式）
#
# 复制到 bidder-agent 的 compose .env 或 secrets，替换占位符。
# client_secret 仅放后端，禁止进入浏览器或前端构建产物。
#
# 平台管理员在 WeKnora「租户管理 → 接入信息」可查看完整变量；
# allowed_origins 须等于浏览器加载 WeKnora 前端时的页面 Origin（同域反代 = 宿主 Origin）。

WEKNORA_ENABLED=true

# 浏览器看到的知识库 / Widget 地址（同域反代时 = 宿主公网入口）
WEKNORA_FRONTEND_URL=https://host-project.example.com

# bootstrap ticket 绑定的 Origin（同域反代时与 WEKNORA_FRONTEND_URL 相同）
WEKNORA_INTEGRATION_ORIGIN=https://host-project.example.com

# 服务端 Integration API（Docker 内网；主机名须与 WeKnora override 中的别名一致）
WEKNORA_INTEGRATION_BASE_URL=http://external-weknora:8080/api/integration/v1
WEKNORA_INTEGRATION_API_VERSION=integration/v1

# Integration Client（在 WeKnora 平台管理创建接入后获得）
WEKNORA_INTEGRATION_CLIENT_ID=<integration-client-id>
WEKNORA_INTEGRATION_CLIENT_SECRET=<integration-client-secret>

# 宿主业务租户 ID（外部身份映射用，不是 WeKnora 数字 tenant_id）
WEKNORA_INTEGRATION_TENANT_ID=<host-tenant-or-workspace-id>

# HTTP 开发/内网入口时允许（生产 HTTPS 建议 false）
WEKNORA_INTEGRATION_ALLOW_INSECURE_HTTP=false

WEKNORA_TIMEOUT_SECONDS=60

# 可选：业务侧绑定的知识库 ID（RAG / 投标场景）
# WEKNORA_BID_BUSINESS_KB_ID=<weknora-knowledge-base-id>

# 可选：溯源（运维对照）
# WEKNORA_SOURCE_BRANCH=development
# WEKNORA_SOURCE_COMMIT=<git-commit>
# WEKNORA_IMAGE_DIGEST=sha256:<image-digest>
