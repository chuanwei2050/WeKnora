[Unit]
Description=WeKnora Airgap Rerank (bge-reranker-v2-m3)
After=network.target
Wants=network-online.target

[Service]
Type=simple
Environment=AIR_GAPPED_MODE=true
Environment=MODEL_DIR=@DATA_DIR@/models/rerank
Environment=SERVED_MODEL_NAME=bge-reranker-v2-m3
Environment=PORT=8002
Environment=QUANT=onnx-int8
WorkingDirectory=@DATA_DIR@/services/rerank
ExecStart=@PYTHON@ server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
