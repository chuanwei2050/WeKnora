limit_req_zone $binary_remote_addr zone=weknora_model_rate:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=weknora_model_conn:10m;

server {
    listen {{LISTEN_PORT}} ssl;
    server_name {{SERVER_NAME}};

    ssl_certificate {{CERTIFICATE_PATH}};
    ssl_certificate_key {{CERTIFICATE_KEY_PATH}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 100m;
    limit_req zone=weknora_model_rate burst=20 nodelay;
    limit_req_status 429;
    limit_conn weknora_model_conn 10;

    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    proxy_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

{{MODEL_ROUTES}}
    location / {
        return 404;
    }
}
